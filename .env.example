# Public address of this instance (no trailing slash). Required.
PASTR_BASE_URL=https://paste.example.com

# First admin account. Used only while no users exist; remove afterwards.
PASTR_ADMIN_USERNAME=admin
PASTR_ADMIN_PASSWORD=

# Your reverse proxy as pastr sees it: one IP address or a CIDR range. With this set,
# sign-in throttling uses the visitor's address from X-Forwarded-For. Without it,
# every visitor behind the proxy shares one throttle.
# PASTR_TRUSTED_PROXY=172.18.0.0/16

# Optional Umami analytics. Set both or neither.
# PASTR_UMAMI_SCRIPT_URL=https://umami.example.com/script.js
# PASTR_UMAMI_WEBSITE_ID=

# Defaults, rarely changed.
# PASTR_ADDR=:8080
# PASTR_DB_PATH=/data/pastr.db
